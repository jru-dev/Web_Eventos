@model List<Inscripcion>
@{
    ViewData["Title"] = "Inscripciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Inscripciones</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva inscripción</a>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Evento</th>
                <th>Asistente</th>
                <th>Fecha de inscripción</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Evento?.Titulo</td>
                    <td>@i.Asistente?.Nombres</td>
                    <td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <span class="badge @(i.Estado == EstadosInscripcion.Confirmada ? "text-bg-success" : "text-bg-secondary")">@i.Estado</span>
                    </td>
                    <td>
                        @if (i.Estado == EstadosInscripcion.Confirmada)
                        {
                            <form asp-action="Cancelar" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Cancelar esta inscripción?');">
                                <input type="hidden" name="id" value="@i.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">No hay inscripciones registradas.</td></tr>
            }
        </tbody>
    </table>
</div>
