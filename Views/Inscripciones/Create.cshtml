@model Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<h1 class="h3 mb-3">Nueva inscripción</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="EventoId" class="form-label"></label>
                <select asp-for="EventoId" class="form-select" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Eventos)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="EventoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AsistenteId" class="form-label"></label>
                <select asp-for="AsistenteId" class="form-select" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Asistentes)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="AsistenteId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Inscribir</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
