@model List<EventoItem>
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Eventos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo evento</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="categoriaId" class="form-select" asp-items="@((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categorias)">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Título</th>
                <th>Categoría</th>
                <th>Fecha</th>
                <th>Lugar</th>
                <th>Modalidad</th>
                <th class="text-end">Precio</th>
                <th class="text-center">Aforo</th>
                <th class="text-center">Inscritos</th>
                <th class="text-center">Cupos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Titulo</td>
                    <td>@e.Categoria</td>
                    <td>@e.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@e.Lugar</td>
                    <td><span class="badge @(e.Modalidad == "Virtual" ? "text-bg-info" : "text-bg-secondary")">@e.Modalidad</span></td>
                    <td class="text-end">S/ @e.Precio.ToString("N2")</td>
                    <td class="text-center">@e.Aforo</td>
                    <td class="text-center">@e.Confirmados</td>
                    <td class="text-center">
                        <span class="badge @(e.CuposDisponibles > 0 ? "text-bg-success" : "text-bg-danger")">@e.CuposDisponibles</span>
                    </td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id">Detalle</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id">Eliminar</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center text-muted">No hay eventos para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>
