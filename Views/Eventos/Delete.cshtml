@model EventoItem
@{
    ViewData["Title"] = "Eliminar evento";
}

<h1 class="h3 mb-3">Eliminar evento</h1>
<div class="alert alert-warning">¿Seguro que desea eliminar este evento? (eliminación lógica: se marcará como inactivo)</div>

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@Model.Categoria</dd>
    <dt class="col-sm-3">Fecha y hora</dt>
    <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-3">Lugar</dt>
    <dd class="col-sm-9">@Model.Lugar</dd>
    <dt class="col-sm-3">Inscritos confirmados</dt>
    <dd class="col-sm-9">@Model.Confirmados</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>
